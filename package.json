{
  "name": "glimmer-mile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GLIMMER MILE – Neon-Boulevard-Arcade-Racer im Browser",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run build:pages && vite build -c vite.server.config.ts",
    "build:game": "tsc --noEmit && vite build",
    "build:admin": "vite build -c vite.admin.config.ts",
    "build:server": "vite build -c vite.server.config.ts",
    "start": "node dist-server/index.mjs",
    "db:info": "node dist-server/cli.mjs db:info",
    "admin:passwd": "node dist-server/cli.mjs admin:passwd",
    "admin:logout-all": "node dist-server/cli.mjs admin:logout-all",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:browser": "node scripts/smoke.mjs smoke-out",
    "test:lifecycle": "node scripts/lifecycle.mjs",
    "test:input": "node scripts/input.mjs",
    "build:pages": "tsc --noEmit && node scripts/build_pages.mjs https://www.sunsetsideways.com",
    "admin:hash": "vite build -c vite.server.config.ts --logLevel error && node dist-server/cli.mjs admin:hash",
    "build:static": "npm run build:pages"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "playwright-core": "^1.65.0",
    "typescript": "*",
    "vite": "*",
    "vitest": "*"
  },
  "engines": {
    "node": ">=22.5"
  }
}
